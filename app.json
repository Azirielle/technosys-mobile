{
  "expo": {
    "name": "Technocycle",
    "slug": "technosys-app",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/technosys_mobile.png",
    "scheme": "hrismobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "config": {
        "googleMapsApiKey": "AIzaSyC3u_bUxVcLxnHfWrBsi0me2R3MKQ-WV1Y"
      },
      "bundleIdentifier": "com.technosys.hrismobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC3u_bUxVcLxnHfWrBsi0me2R3MKQ-WV1Y"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.technosys.hrismobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "versionCode": 9
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TechnoSys checks that you are at the work site when you time in, and shares your location with the office only while you are timed in.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TechnoSys uses Face ID so you can sign in without typing your PIN."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36119a6f-9feb-4d18-a676-6cfc6f20844d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/36119a6f-9feb-4d18-a676-6cfc6f20844d",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "technosyss-team"
  }
}
